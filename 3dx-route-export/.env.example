# Copy to .env and fill in. .env is never committed or shared.
THREEDX_BASE_URL=https://r1132101268131-eu1.iam.3dexperience.3ds.com/login?serverId=FRONT_1_8089&service=https%3A//r1132101268131-indw2-ifwe.3dexperience.3ds.com/%3FserverId%3DFRONT_1_8089%23app%3AENXROUT_AP
THREEDX_USERNAME=
THREEDX_PASSWORD=
# Typed into the dashboard top bar search, then the app with this name is opened from the results
THREEDX_SEARCH_TEXT=Route
THREEDX_APP_NAME=Route Management
HEADLESS=false

# Shared Google Sheet for route_tasks.py. Preferred: save the CSV in a Google Drive for desktop folder;
# the sheet's Apps Script (docs/apps-script/plmRouteTasksImport.gs) imports it. No web app or sign-in.
PLM_SHEET_DRIVE_DIR=G:\My Drive\PLM Route Tasks
# Older way (Apps Script web app: docs/apps-script/plmRouteTasks.gs); only used when PLM_SHEET_DRIVE_DIR is empty
PLM_SHEET_WEB_APP_URL=
PLM_SHEET_TOKEN=
# Tab id: the number after gid= in the sheet link
PLM_SHEET_GID=366646702
